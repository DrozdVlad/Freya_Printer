# Telegram
# Токен від @BotFather
BOT_TOKEN=123456:AA...

# Кому дозволено користуватись ботом (Telegram user id через кому).
# Порожньо = дозволено всім (НЕ рекомендується на проді).
ALLOWED_USER_IDS=

# Принтер Citizen CT-E351
# network | usb | serial | file
PRINTER_BACKEND=network

# --- network (CT-E351 з Ethernet-інтерфейсом, RAW порт 9100) ---
# Дані з мережевого листа принтера:
#   MAC 00:0D:AC:34:24:4B | DHCP OFF | Subnet 255.255.0.0 | Gateway 192.168.100.1
PRINTER_HOST=192.168.100.210
PRINTER_PORT=9100
PRINTER_TIMEOUT=15

# --- usb (CT-E351 через USB) ---
# Дізнатись: lsusb  →  "Bus 001 Device 005: ID 1cb0:0003 ..."
PRINTER_USB_VENDOR=0x1cb0
PRINTER_USB_PRODUCT=0x0003
# Залишити порожнім для автовизначення точок підключення
PRINTER_USB_IN_EP=
PRINTER_USB_OUT_EP=

# --- serial ---
PRINTER_SERIAL_PORT=/dev/ttyUSB0
PRINTER_SERIAL_BAUDRATE=115200

# --- file (друк напряму в пристрій, напр. USB-lp) ---
PRINTER_FILE_PATH=/dev/usb/lp0

# Розмір паперу
# 203 dpi = рівно 8 точок на міліметр.
# Ширина 72 мм = 576 точок (стандартна область друку на стрічці 80 мм).
# Довжина 148 мм = 1184 точки — рівно стільки відрізає ніж на кожну копію.
PAPER_WIDTH_MM=72
PAPER_LENGTH_MM=148
DOTS_PER_MM=8
# Зсув вмісту вниз у мм (для калібрування, якщо друк іде вище/нижче центру)
CONTENT_OFFSET_MM=0
# Явна ширина в точках; порожньо = рахується з PAPER_WIDTH_MM (має ділитись на 8)
PRINT_WIDTH=

# Друк
FONT_PATH=fonts/Lora-Regular.ttf
FONT_SIZE_TITLE=46
FONT_SIZE_BODY=40
FONT_SIZE_SMALL=32
# Порожніх рядків перед відрізанням (для режиму без фіксованої довжини)
FEED_LINES=4
# Різати папір після кожної копії
CUT_PAPER=true
# Максимум копій за один раз
MAX_COPIES=50
# Часовий пояс для кнопки "Зараз"
TIMEZONE=Europe/Kyiv
