[Unit]
Description=Telegram bot -> Citizen CT-E351 printer
Documentation=file:///opt/printer-bot/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=printerbot
Group=printerbot
# Доступ до USB/серійного принтера
SupplementaryGroups=lp dialout plugdev
WorkingDirectory=/opt/printer-bot
ExecStart=/opt/printer-bot/.venv/bin/python -m bot.main
Restart=always
RestartSec=5
# Код 78 — помилка конфігурації: перезапуск не допоможе, чекаємо на людину
RestartPreventExitStatus=78
# Якщо Telegram недоступний довго — не здаватися
StartLimitIntervalSec=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=printer-bot

# Мінімальне посилення безпеки
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
